programa PRACTICA_2_1

procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
        tomarFlor
        cantFlores:= cantFlores + 1
  fin

 proceso calcularMaximo(ES max: numero; E floresR2:numero; floresR1:numero)
 variables
    noMax: numero
    dif: numero
 comenzar
    noMax:= 0
    si(floresR2 > floresR1)
      max:= floresR2
      noMax:= floresR1
    sino
      max:= floresR1
      noMax:= floresR2
     
     dif:= max-noMax
     
     
 fin
 

areas
  area1: AreaP (1,1,1,10)
  area2: AreaP (2,11,2,20)


robots
  robot florero
  variables
    cantFlores: numero
  comenzar
    cantFlores:= 0
    repetir 9
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)
    EnviarMensaje(cantFlores,R2)
    RecibirMensaje(
    
  fin
  
  robot informador
  variables
    floresR2: numero
    floresR1: numero
    max: numero
  comenzar
    max:= -1
    floresR2:= 0
    floresR1: 0
    repetir 9
      juntarFlores(floresR2)
      mover
    juntarFlores(floresR2)
    RecibirMensaje(floresR1, R1)
    calcularMaximo(max, floresR2, floresR1)  
  fin
  
  
variables
  R1: florero
  R2: informador
comenzar
  AsignarArea(R1, area1)
  Iniciar(R1, 1,1)
  AsignarArea(R2, area2)
  Iniciar(R2, 2,11)
fin