programa PRACTICA_2_1
procesos
  proceso juntarFlores(ES flores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:= flores + 1
  fin
  
  proceso calcularMaximo(E flores: numero; ES max: numero)
  comenzar
    si(flores > max)
      max:= flores
  fin
  
areas
  area1: AreaP (1,1,1,10)
  area2: AreaP (2,11,2,20)
  area3: AreaP (3,21,3,30)
  area4: AreaP (4,31,4,40)
  area5: AreaP (5,41,5,50)
  area6: AreaP (6,51,6,60)
  area7: AreaP (2,1,2,1)

robots
  robot florero
  variables
    flores: numero
    dif: numero
  comenzar
    flores:= 0
    repetir 9
      juntarFlores(flores)
      mover
    juntarFlores(flores)
    EnviarMensaje(flores,Fisc)
  fin
  
  robot fiscalizador
  variables
    flores: numero
    max: numero
  comenzar
    flores:= 0
    max:= 0
    repetir 6
      RecibirMensaje(flores, *)
      calcularMaximo(flores,max)
    Informar("El ganador obtuvo una cant de flores de ", max)  
  fin
  
variables
  R1: florero
  R2: florero
  Fisc: fiscalizador
  R3: florero
  R4: florero
  R5: florero
  R6: florero
comenzar
  AsignarArea(R1, area1)
  AsignarArea(R2, area2)
  AsignarArea(R3, area3)
  AsignarArea(R4, area4)
  AsignarArea(R5, area5)
  AsignarArea(R6, area6)
  AsignarArea(Fisc, area7)
  Iniciar(R1, 1,1)
  Iniciar(R2, 2,11)
  Iniciar(R3, 3,21)
  Iniciar(R4, 4,31)
  Iniciar(R5, 5,41)
  Iniciar(R6, 6,51)
  Iniciar(Fisc, 2,1)
fin
