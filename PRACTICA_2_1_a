programa PRACTICA_2_1
procesos
  proceso juntarFlores(ES flores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:= flores + 1
  fin
  
  proceso calcularMaximo(E floresR1: numero; E floresR2: numero)
  variables
    max: numero
    noMax: numero
  comenzar
    si(floresR1 > floresR2)
      max:= floresR1
      noMax:= floresR2
      EnviarMensaje(max-noMax, R1)
    sino
      max:= floresR2
      noMax:= floresR1
      EnviarMensaje(0, R1)
      Informar("R2 obtuvo mas flores por una dif de", max-noMax)
  fin
  
areas
  area1: AreaP (1,1,1,10)
  area2: AreaP (2,11,2,20)

robots
  robot florero
  variables
    floresR1: numero
    dif: numero
  comenzar
    floresR1:= 0
    repetir 9
      juntarFlores(floresR1)
      mover
    juntarFlores(floresR1)
    EnviarMensaje(floresR1,R2)
    RecibirMensaje(dif,R2)
    si(dif > 0)
      Informar("R1 obtuvo mas flores por una dif de",dif)
  fin
  
  robot informador
  variables
    floresR2: numero
    floresR1: numero
  comenzar
    floresR2:= 0
    floresR1:= 0
    repetir 9
      juntarFlores(floresR2)
      mover
    juntarFlores(floresR2)
    RecibirMensaje(floresR1,R1)
    calcularMaximo(floresR1,floresR2)
  fin
  
variables
  R1: florero
  R2: informador
comenzar
  AsignarArea(R1, area1)
  AsignarArea(R2, area2)
  Iniciar(R1, 1,1)
  Iniciar(R2, 2,11)
fin
